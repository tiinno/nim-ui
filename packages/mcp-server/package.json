{
  "name": "@nim-ui/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Nim UI — exposes the component registry, design tokens, and docs so an AI assistant can discover and use the kit.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nim-ui",
    "react",
    "ui",
    "design-system",
    "ai"
  ],
  "homepage": "https://nim-ui.tiinno.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiinno/nim-ui.git",
    "directory": "packages/mcp-server"
  },
  "bugs": "https://github.com/tiinno/nim-ui/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "nim-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "claude-desktop-config.example.json"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-sources.mjs",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nim-ui/components": "workspace:*",
    "@nim-ui/tailwind-config": "workspace:*",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
